<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="20dp"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imgMainTitle"
        android:layout_width="189dp"
        android:layout_height="70dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:adjustViewBounds="true"
        android:scaleType="fitStart"
        android:src="@drawable/ic_cat_imut"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/btnOpenHistory"
        android:layout_width="52dp"
        android:layout_height="53dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Buka Riwayat"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_recent_history"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#66368a" />

    <ImageView
        android:id="@+id/btnOpenDictionary"
        android:layout_width="52dp"
        android:layout_height="53dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Buka Smart Dictionary"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_agenda"
        app:layout_constraintEnd_toStartOf="@id/btnOpenHistory"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#66368a" />

    <LinearLayout
        android:id="@+id/boxInputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_light"
        android:padding="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/imgMainTitle">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Text Translator"
            android:textColor="#111827"
            android:textStyle="bold"
            android:textSize="14sp"/>

        <EditText
            android:id="@+id/etInput"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Masukkan teks yang ingin diterjemahkan di sini..."
            android:textColorHint="#9CA3AF"
            android:textColor="#374151"
            android:gravity="top|start"
            android:background="@android:color/transparent"
            android:textSize="15sp"
            android:layout_marginTop="8dp"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"/>
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnTranslate"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_button_solid"
        android:backgroundTint="#66368a"
        android:stateListAnimator="@null"
        android:text="Translate Now"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/boxInputContainer"
        tools:layout_editor_absoluteX="20dp" />

    <LinearLayout
        android:id="@+id/boxResultContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card_light"
        android:padding="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintTop_toBottomOf="@id/btnTranslate"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Translation Result"
            android:textColor="#111827"
            android:textStyle="bold"
            android:textSize="14sp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:fillViewport="true">

            <TextView
                android:id="@+id/tvResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Hasil terjemahan teks akan muncul di sini..."
                android:textColor="#374151"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"
                android:fontFamily="sans-serif-medium"/>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end|center_vertical"
            android:layout_marginTop="8dp">

            <ImageView
                android:id="@+id/btnSpeak"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_speaker"
                app:tint="#4B5563"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Speak Text" />

            <ImageView
                android:id="@+id/btnCopy"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="12dp"
                android:src="@drawable/ic_copy"
                app:tint="#4B5563"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Copy Text" />

            <ImageView
                android:id="@+id/btnFavorite"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="12dp"
                android:src="@drawable/ic_favorites_new"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Favorite Text" />

        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>