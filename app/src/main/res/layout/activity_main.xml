<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:padding="20dp"
    tools:context=".MainActivity">

    <View
        android:id="@+id/topRightCircle"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/bg_gradient_circle"
        android:alpha="0.25"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:translationX="60dp"
        android:translationY="-40dp"/>

    <View
        android:id="@+id/leftCenterCircle"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@drawable/bg_gradient_circle"
        android:backgroundTint="@color/neon_cyan"
        android:alpha="0.15"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:translationX="-40dp"/>

    <View
        android:id="@+id/bottomRightCircle"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:background="@drawable/bg_gradient_circle"
        android:backgroundTint="@color/neon_purple"
        android:alpha="0.20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:translationX="40dp"
        android:translationY="40dp"/>

    <TextView
        android:id="@+id/tvMainTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PertaLite"
        android:textColor="@color/pure_white"
        android:textSize="32sp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.02"
        android:layout_marginTop="8dp"
        android:layout_marginStart="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <LinearLayout
        android:id="@+id/boxInputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_dark"
        android:padding="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvMainTitle">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Text Translator"
            android:textColor="@color/pure_white"
            android:textStyle="bold"
            android:textSize="14sp"/>

        <EditText
            android:id="@+id/etInput"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Masukkan teks di sini..."
            android:textColorHint="#8A8A9E"
            android:textColor="@color/pure_white"
            android:gravity="top|start"
            android:background="@android:color/transparent"
            android:textSize="15sp"
            android:layout_marginTop="6dp"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#26FFFFFF"
            android:layout_marginVertical="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart Dictionary"
            android:textColor="@color/pure_white"
            android:textStyle="bold"
            android:textSize="14sp"/>

        <EditText
            android:id="@+id/etInputDictionary"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:hint="Cari kata atau frasa kamus..."
            android:textColorHint="#8A8A9E"
            android:textColor="@color/pure_white"
            android:gravity="center_vertical"
            android:background="@android:color/transparent"
            android:textSize="15sp"
            android:layout_marginTop="4dp"
            android:importantForAutofill="no"
            android:inputType="text"/>
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnTranslate"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="20dp"
        android:text="Translate Now"
        android:textColor="@color/pure_white"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textAllCaps="false"
        android:stateListAnimator="@null"
        android:background="@drawable/bg_button_vibrant"
        app:layout_constraintTop_toBottomOf="@id/boxInputContainer"/>

    <LinearLayout
        android:id="@+id/boxResultContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card_dark"
        android:padding="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintTop_toBottomOf="@id/btnTranslate"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Translation Result"
                android:textColor="@color/pure_white"
                android:textStyle="bold"
                android:textSize="14sp"/>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/tvResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hasil terjemahan teks..."
                    android:textColor="@color/neon_cyan"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"/>
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end|center_vertical"
                android:layout_marginTop="4dp">

                <ImageView
                    android:id="@+id/btnSpeak"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_speaker"
                    android:padding="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Speak Text" />

                <ImageView
                    android:id="@+id/btnCopy"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="12dp"
                    android:src="@drawable/ic_copy"
                    android:padding="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Copy Text" />

                <ImageView
                    android:id="@+id/btnFavorite"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:backgroundTint="#851212"
                    android:contentDescription="Favorite Text"
                    android:padding="6dp"
                    android:src="@drawable/ic_favorite" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#26FFFFFF"
            android:layout_marginVertical="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dictionary Definition"
                android:textColor="@color/pure_white"
                android:textStyle="bold"
                android:textSize="14sp"/>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="6dp"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/tvResultDictionary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Definisi kamus akan tampil di sini..."
                    android:textColor="@color/neon_pink"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"/>
            </ScrollView>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>