<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="20dp"
    tools:context=".ui.DictionaryFragment">

    <!-- Toolbar sederhana, samain pola sama HistoryActivity -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarDictionary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:title="Smart Dictionary"
        android:titleTextColor="#111827"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Card input kata -->
    <LinearLayout
        android:id="@+id/boxSearchContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_light"
        android:padding="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarDictionary">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cari Kata"
            android:textColor="#111827"
            android:textStyle="bold"
            android:textSize="14sp"/>

        <EditText
            android:id="@+id/etWord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Masukkan kata dalam Bahasa Inggris..."
            android:textColorHint="#9CA3AF"
            android:textColor="#374151"
            android:background="@android:color/transparent"
            android:textSize="15sp"
            android:layout_marginTop="8dp"
            android:importantForAutofill="no"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true"/>
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSearch"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_button_solid"
        android:backgroundTint="#66368a"
        android:stateListAnimator="@null"
        android:text="Search"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/boxSearchContainer" />

    <!-- Card hasil pencarian -->
    <LinearLayout
        android:id="@+id/boxResultContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card_light"
        android:padding="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintTop_toBottomOf="@id/btnSearch"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hasil"
            android:textColor="#111827"
            android:textStyle="bold"
            android:textSize="14sp"/>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Kata + pelafalan -->
                <TextView
                    android:id="@+id/tvWord"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#111827"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    tools:text="hello"/>

                <TextView
                    android:id="@+id/tvPhonetic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#66368a"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp"
                    tools:text="/həˈloʊ/"/>

                <!-- Jenis kata -->
                <TextView
                    android:id="@+id/tvPartOfSpeech"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#4B5563"
                    android:textStyle="italic"
                    android:textSize="13sp"
                    android:layout_marginTop="10dp"
                    tools:text="noun"/>

                <!-- Definisi -->
                <TextView
                    android:id="@+id/tvDefinition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#374151"
                    android:textSize="16sp"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="6dp"
                    tools:text="Used as a greeting."/>

                <!-- Contoh kalimat -->
                <TextView
                    android:id="@+id/tvExample"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#9CA3AF"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="8dp"
                    tools:text="Hello! How are you?"/>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>