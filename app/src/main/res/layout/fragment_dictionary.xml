<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="20dp"
    tools:context=".ui.DictionaryFragment">

    <ImageView
        android:id="@+id/imgLogoPawcabulary"
        android:layout_width="186dp"
        android:layout_height="90dp"
        android:layout_marginTop="12dp"
        android:adjustViewBounds="true"
        android:contentDescription="Logo Pawcabulary"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_smart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.567"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/boxSearchContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_light"
        android:padding="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/imgLogoPawcabulary">

        <EditText
            android:id="@+id/etWord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Masukkan kata dalam Bahasa Inggris..."
            android:textColorHint="#9CA3AF"
            android:textColor="#374151"
            android:background="@android:color/transparent"
            android:textSize="15sp"
            android:layout_marginTop="1dp"
            android:importantForAutofill="no"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true"
            android:drawableEnd="@drawable/ic_search"
            android:drawableTint="#9CA3AF" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSearch"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_button_solid"
        android:backgroundTint="#66368a"
        android:stateListAnimator="@null"
        android:text="Search"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/boxSearchContainer" />

    <LinearLayout
        android:id="@+id/boxResultContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:minHeight="180dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card_light"
        android:padding="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintTop_toBottomOf="@id/btnSearch"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hasil Pencarian"
            android:textColor="#111827"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="12dp"/>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:visibility="gone"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvWord"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#111827"
                    android:textStyle="bold"
                    android:textSize="24sp"
                    tools:text="hello"/>

                <TextView
                    android:id="@+id/tvPhonetic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#66368a"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp"
                    tools:text="/həˈloʊ/"/>

                <TextView
                    android:id="@+id/tvPartOfSpeech"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:background="#4B5563"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"
                    tools:text="noun"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E5E7EB"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tvDefinition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#374151"
                    android:textSize="15sp"
                    android:lineSpacingExtra="5dp"
                    tools:text="English:\nUsed as a greeting.\n\nIndonesian:\nDigunakan sebagai sapaan."/>

                <TextView
                    android:id="@+id/tvExample"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#9CA3AF"
                    android:textSize="13sp"
                    android:textStyle="italic"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="16dp"
                    tools:text="&quot;Hello! How are you?&quot;"/>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>